{
  "name": "conta-certa",
  "version": "1.0.0",
  "main": "dist-electron/main.js",
  "author": "DuckCoder1101",
  "description": "Programa de gerenciamento financeiro para escritórios",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "build": {
    "appId": "conta.certa",
    "asar": true,
    "asarUnpack": [
      "node_modules/.prisma",
      "node_modules/@prisma/client"
    ],
    "files": [
      "dist/",
      "dist-electron/",
      "node_modules/",
      "package.json"
    ],
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@prisma/client": "^6.19.0",
    "csv-parse": "^6.1.0",
    "esbuild": "^0.27.2",
    "i18next": "^25.8.0",
    "nanoid": "^5.1.6",
    "prisma": "^6.19.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.71.1",
    "react-i18next": "^16.5.4",
    "react-icons": "^5.5.0",
    "react-number-format": "^5.4.4",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@types/jquery": "^3.5.33",
    "@types/node": "^25.2.0",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "electron": "^39.4.0",
    "electron-builder": "^26.7.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.5",
    "i18next-cli": "^1.41.1",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "tailwindcss": "^3.4.18",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.2",
    "vite": "^7.3.1",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
}
